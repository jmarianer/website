{
  "name": "lok-solver",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:core && npm run test:cli",
    "test:core": "vitest run",
    "test:cli": "bats test/cli/",
    "cli": "tsx src/cli/main.ts",
    "start": "BROWSER=open vite dev --open",
    "build": "vite build",
    "lint": "prettier --check --ignore-path ../.gitignore . && eslint .",
    "format": "prettier --write --ignore-path ../.gitignore ."
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^24",
    "@vitest/browser-playwright": "^4.1.3",
    "eslint": "^10.2.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.1",
    "sass": "^1.99.0",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "tsx": "^4.23.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "vitest": "^4.1.3",
    "vitest-browser-svelte": "^2.1.0"
  }
}
